{
  "name": "gview",
  "version": "1.3.0",
  "description": "GView desktop viewer app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "keywords": [
    "ply",
    "viewer",
    "electron"
  ],
  "author": "Jjeyara",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.jjeyara.gview",
    "productName": "GView",
    "files": [
      "main.js",
      "preload.js",
      "PlyViewer.html"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "icon": "C:/Users/Jjeyara/Downloads/LogoNew.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}

